[Unit]
Description=server-monitor (Prometheus, Grafana, node-exporter, cAdvisor, blackbox; Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INSTALL_DIR@
ExecStartPre=/usr/bin/install -d -m 755 /var/lib/server-monitor/textfile /var/lib/server-monitor/targets
ExecStartPre=@INSTALL_DIR@/bin/sm-telegram render
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
