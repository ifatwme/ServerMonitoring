GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROM_PORT=9090
PROM_RETENTION_TIME=90d
PROM_RETENTION_SIZE=2GB
MONITOR_SUBNET=172.30.250.0/24
MONITOR_GATEWAY=172.30.250.1
SM_STATE_DIR=/var/lib/server-monitor
# systemd units node-exporter reports (regex); add your projects' unit prefixes
SYSTEMD_UNIT_INCLUDE=(docker|containerd|ssh|cron|chrony|server-monitor.*)\.(service|timer)
# optional public Grafana (see deploy/compose.public.yml)
# COMPOSE_FILE=docker-compose.yml:deploy/compose.public.yml
# HTTPS_PORT=
# GF_ROOT_URL=https://monitor.example.org/
# CERT_IDENTIFIER=monitor.example.org
# ACME_SERVER=
# ACME_EMAIL=
# ACME_EAB_KID=
# ACME_EAB_HMAC=

# Telegram notifications (optional; see docs/telegram.md). Leave empty to disable.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100...           # a supergroup with Topics enabled; bot needs "Manage topics"
