{
 "uid": "sm-insights",
 "title": "Insights: who uses the CPU, what the limits should be",
 "description": "Regression-based CPU attribution to traffic classes and PSI/OOM-aware right-sizing.",
 "tags": [
  "server-monitor"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "method",
    "label": "Attribution model",
    "type": "custom",
    "query": "burst,5m",
    "current": {
     "text": "burst",
     "value": "burst"
    },
    "options": [
     {
      "text": "burst",
      "value": "burst",
      "selected": true
     },
     {
      "text": "5m",
      "value": "5m",
      "selected": false
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "CPU attribution: what each project's CPU is actually spent on",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "barchart",
   "title": "CPU share by cause (regression)",
   "description": "baseline = CPU burned regardless of traffic (workers, demo loops, idle models). Other bars = CPU explained by each traffic class. method=burst uses 1 Hz samples (identifies steady crawlers); method=5m uses Prometheus history.",
   "targets": [
    {
     "expr": "sm_attribution_share{method=\"$method\"}",
     "legendFormat": "__auto",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "rowField": "project",
      "columnField": "component",
      "valueField": "Value",
      "emptyValue": "zero"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "baseline"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8e8e8e"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "human"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ai_bot"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "bot"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "scanner"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
