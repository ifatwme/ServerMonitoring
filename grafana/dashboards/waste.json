  {
   "type": "table",
   "title": "Images no container uses",
   "description": "`projctl cleanup` removes them (dry-run first). Rows without a size are in-use images: ignore.",
   "targets": [
    {
     "expr": "sm_docker_image_bytes{in_use=\"0\"}",
