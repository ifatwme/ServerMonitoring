{
 "uid": "sm-overview",
 "title": "Server overview",
 "description": "Host health and every project's share of it.",
 "tags": [
  "server-monitor"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
