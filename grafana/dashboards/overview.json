  {
   "type": "table",
   "title": "Projects at a glance",
   "description": "Visitors = distinct IPs that loaded a page AND its assets (real browsers). Idle = time since the newest of: engaged visit, commit, uncommitted edit, image build, container start (tests).",
   "targets": [
    {
     "expr": "max by (project) (probe_success{job=\"uptime\"})",
     "legendFormat": "__auto",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "expr": "project:probe_success:avg7d",
     "legendFormat": "__auto",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "expr": "project:cpu_cores:rate2m",
     "legendFormat": "__auto",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "expr": "avg_over_time(project:cpu_cores:rate2m[24h])",
     "legendFormat": "__auto",
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
