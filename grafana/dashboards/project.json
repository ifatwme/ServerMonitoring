      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "expr": "(time() - sm_container_started_timestamp_seconds{project=\"$project\"}) * sm_container_up{project=\"$project\"}",
