     "legendFormat": "__auto",
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "service",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "project": true,
       "container": true,
       "Value #A": true
      },
      "renameByName": {
       "service": "Service",
       "state": "State",
       "health": "Health",
       "Value #B": "Restarts",
       "Value #C": "Up for",
       "Value #D": "Mem limit",
       "Value #E": "Last exit OOM",
       "image": "Image"
      },
      "indexByName": {
       "service": 0,
       "state": 1,
       "health": 2,
       "Value #B": 3,
       "Value #C": 4,
       "Value #D": 5,
       "Value #E": 6,
       "image": 7
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "running": {
            "color": "green"
           },
           "exited": {
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Health"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "healthy": {
            "color": "green"
           },
           "unhealthy": {
            "color": "red"
           },
           "none": {
            "color": "text"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
