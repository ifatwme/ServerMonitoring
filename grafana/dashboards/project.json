  {
   "type": "table",
   "title": "Last activity",
   "description": "commit / edit (uncommitted or dev-dir files) / build (newest project image) / container_start (incl. `compose run` tests) / human_visit (engaged browser)",
   "targets": [
    {
     "expr": "sm_project_last_activity_timestamp_seconds{project=\"$project\"} * 1000",
     "legendFormat": "__auto",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "project": true
      },
      "renameByName": {
       "signal": "Signal",
       "Value": "When"
      },
      "indexByName": {
       "signal": 0,
       "Value": 1
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "When"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeFromNow"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "id": 10,
   "gridPos": {
